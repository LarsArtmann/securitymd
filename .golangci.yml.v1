version: "2"

run:
  timeout: 5m
  go: 1.26.1
  build-tags:
    - goexperiment.goroutineleakprofile
    - goexperiment.jsonv2
    - goexperiment.simd
  modules-download-mode: readonly
  allow-parallel-runners: true
  allow-serial-runners: true
  issues-exit-code: 1
  tests: true

output:
  formats: {}

linters:
  enable:
    - arangolint
    - asasalint
    - asciicheck
    - bidichk
    - bodyclose
    - canonicalheader
    - containedctx
    - contextcheck
    - copyloopvar
    - cyclop
    - decorder
    - dogsled
    - dupl
    - dupword
    - durationcheck
    - embeddedstructfieldcheck
    - err113
    - errcheck
    - errchkjson
    - errname
    - errorlint
    - exhaustive
    - exhaustruct
    - exptostd
    - fatcontext
    - forbidigo
    - forcetypeassert
    - funlen
    - ginkgolinter
    - gocheckcompilerdirectives
    - gochecknoglobals
    - gochecknoinits
    - gochecksumtype
    - gocognit
    - goconst
    - gocritic
    - gocyclo
    - godoclint
    - godot
    - godox
    - goheader
    - gomoddirectives
    - gomodguard
    - goprintffuncname
    - gosec
    - gosmopolitan
    - govet
    - grouper
    - iface
    - importas
    - inamedparam
    - ineffassign
    - interfacebloat
    - intrange
    - iotamixing
    - ireturn
    - loggercheck
    - maintidx
    - makezero
    - mirror
    - misspell
    - mnd
    - modernize
    - musttag
    - nakedret
    - nestif
    - nilerr
    - nilnesserr
    - nilnil
    - nlreturn
    - noctx
    - noinlineerr
    - nolintlint
    - nonamedreturns
    - nosprintfhostport
    - paralleltest
    - perfsprint
    - prealloc
    - predeclared
    - promlinter
    - protogetter
    - reassign
    - recvcheck
    - revive
    - rowserrcheck
    - sloglint
    - spancheck
    - sqlclosecheck
    - staticcheck
    - tagalign
    - tagliatelle
    - testableexamples
    - testifylint
    - thelper
    - tparallel
    - unconvert
    - unparam
    - unqueryvet
    - unused
    - usestdlibvars
    - usetesting
    - varnamelen
    - wastedassign
    - whitespace
    - wrapcheck
    - wsl_v5
    - zerologlint
  disable:
    - funcorder
    - depguard
    - testpackage

formatters:
  enable:
    - gci
    - goimports
    - gofumpt
    - golines

linters-settings:
  forbidigo:
    allow:
      - fmt\.(F)?Print(ln)?$
      - fmt\.Fprintf$
      - ^os\.Stderr$
      - ^os\.Stdout$

  gochecknoglobals:
    checks:
      - startingWithUnderscore
      - type:*service*func

  exhaustruct:
    exclude:
      - files:
          - "cmd/template-security/*.go"
          - "internal/security_validator.go"
          - "internal/security_tool.go"

  goprintffuncname:
    skip-check:
      - ^print(Info|Success|Warning|Error)$

  revive:
    confidence: 0.8

  cyclop:
    max-complexity: 15

  gocognit:
    min-complexity: 40

  nestif:
    max-depth: 7

  varnamelen:
    min-length: 3
    ignore-type-asserts: true
    ignore-map-index: true
    ignore-channel-receive: true
    ignore-declared-const: true

  tagliatelle:
    rules:
      - key: json
        values: [camel]

  paralleltest:
    ignore-file: ""

  funlen:
    lines: 80
    statements: 70

  gochecknoinits: true

  testpackage:
    skip-regexp: ".*(_test)\\.go$"

issues:
  exclude-rules:
    # testpackage - skip package name checks for test files
    - linters:
        - testpackage
      text: "package should be"
      path: "_test\\.go$"
    # gochecknoglobals - cmd flags are intentional
    - linters:
        - gochecknoglobals
      path: "cmd/"
    # exhaustruct - cobra commands don't need all fields
    - linters:
        - exhaustruct
      path: "cmd/"
    # forbidigo - CLI output uses fmt print
    - linters:
        - forbidigo
      path: "cmd/"
    # forbidigo - explicit per-file excludes for internal/ PrintResults
    - linters:
        - forbidigo
      path: "internal/security_validator.go"
    - linters:
        - forbidigo
      path: "internal/security_tool.go"
    # paralleltest - explicit per-file-path exclude (ignore-file dir path does not work)
    - linters:
        - paralleltest
      path: "test/acceptance/security_policy_suite_test.go"
    # godoclint - per-file-path excludes for test packages (multiple package docs)
    - linters:
        - godoclint
      path: "internal/security_tool_test.go"
    - linters:
        - godoclint
      path: "internal/security_validator_test.go"
    - linters:
        - godoclint
      path: "test/acceptance/policy_generation_test.go"
    - linters:
        - godoclint
      path: "test/acceptance/security_policy_suite_test.go"
    - linters:
        - godoclint
      path: "test/acceptance/test_helpers.go"
    # varnamelen - explicit per-file-path for security_validator.go
    - linters:
        - varnamelen
      path: "internal/security_validator.go"
    # usetesting - explicit per-file-path for test files
    - linters:
        - usetesting
      path: "internal/security_tool_test.go"
    # exhaustruct for test files
    - linters:
        - exhaustruct
      path: "internal/security_tool_test.go"
    - linters:
        - exhaustruct
      path: "internal/security_validator_test.go"
    # gosec G304 - per-file-path excludes for internal files (false positive)
    - linters:
        - gosec
      path: "internal/security_validator.go"
      text: "G304"
    - linters:
        - gosec
      path: "internal/project_detector.go"
      text: "G304"
    # forbidigo for internal - explicit per-file excludes
    - linters:
        - forbidigo
      path: "internal/security_validator.go"
    - linters:
        - forbidigo
      path: "internal/security_tool.go"
    # funlen - long test functions are acceptable
    - linters:
        - funlen
      path: "internal/"
    - linters:
        - funlen
      path: "test/"
    # gocognit - complex CLI setup is acceptable
    - linters:
        - gocognit
      path: "cmd/"
    - linters:
        - gocognit
      path: "internal/"
    # nestif - complex parsing logic is acceptable
    - linters:
        - nestif
      path: "internal/"
    # mnd - magic numbers in constants are acceptable
    - linters:
        - mnd
      path: "internal/"
    - linters:
        - mnd
      path: "test/"
    # gosec - exclude G304/G301/G306 issues for test files
    - linters:
        - gosec
      path: "_test\\.go$"
      text: "G304|G301|G306"
    # paralleltest - test files excluded
    - linters:
        - paralleltest
      path: "internal/"
    - linters:
        - paralleltest
      path: "test/"
    # revive package-comments for internal packages
    - linters:
        - revive
      text: "package-comments"
      path: "internal/"
    - linters:
        - revive
      text: "package-comments"
      path: "test/"
    # forbidigo for internal
    - linters:
        - forbidigo
      path: "internal/"
    # exhaustruct for test files
    - linters:
        - exhaustruct
      path: "test/"
    # gochecknoglobals for test
    - linters:
        - gochecknoglobals
      path: "test/"
    # noinlineerr - inline errors are acceptable
    - linters:
        - noinlineerr
      path: "cmd/"
    - linters:
        - noinlineerr
      path: "test/"
    - linters:
        - noinlineerr
      path: "internal/"
    # nlreturn - newlines at end of blocks are acceptable
    - linters:
        - nlreturn
      path: "cmd/"
    - linters:
        - nlreturn
      path: "test/"
    - linters:
        - nlreturn
      path: "internal/"
    # copyloopvar - variable shadowing is acceptable
    - linters:
        - copyloopvar
      path: "internal/"
    - linters:
        - copyloopvar
      path: "test/"
    # varnamelen - short variable names are acceptable in test/cmd
    - linters:
        - varnamelen
      path: "test/"
    - linters:
        - varnamelen
      path: "cmd/"
    # paralleltest for cmd
    - linters:
        - paralleltest
      path: "cmd/"
    # usetesting for test files
    - linters:
        - usetesting
      path: "_test\\.go$"
